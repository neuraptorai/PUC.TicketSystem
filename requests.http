# File: requests.http

###
# @name HealthCheck
GET http://localhost:8080/health

###
# @name Login Success
# Tenta fazer login com credenciais válidas.
# Deverá retornar um access_token.
POST http://localhost:8080/api/v1/auth/login
Content-Type: application/json

{
  "email": "user@example.com",
  "password": "password123"
}

###
# @name Get Availability
# Consulta a disponibilidade de ingressos para um evento. (Rota pública)
GET http://localhost:8080/api/v1/events/event-123/availability

###
# @name Create Reservation Success
# Tenta criar uma reserva para um ingresso. Requer token de autenticação.
# ANTES DE EXECUTAR: Faça o login, copie o access_token e cole abaixo.
POST http://localhost:8080/api/v1/reservations
Content-Type: application/json
Authorization: Bearer <SEU_TOKEN_AQUI>

{
  "event_id": "event-123",
  "ticket_type_id": "ticket-type-standard",
  "quantity": 2
}

###
# @name Create Reservation No Auth
# Tenta criar uma reserva sem o token. Deve falhar com 401.
POST http://localhost:8080/api/v1/reservations
Content-Type: application/json

{
  "event_id": "event-123",
  "ticket_type_id": "ticket-type-standard",
  "quantity": 1
}

###
# @name Create Reservation No Stock
# Tenta criar uma reserva para mais ingressos do que o disponível. Deve falhar com 409.
# ANTES DE EXECUTAR: Faça o login, copie o access_token e cole abaixo.
POST http://localhost:8080/api/v1/reservations
Content-Type: application/json
Authorization: Bearer <SEU_TOKEN_AQUI>

{
  "event_id": "event-123",
  "ticket_type_id": "ticket-type-vip",
  "quantity": 999
}